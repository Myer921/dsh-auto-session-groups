{
  "name": "dsh-auto-session-groups",
  "version": "0.8.0",
  "private": false,
  "description": "DSH 插件：用可编辑的提示词让模型把会话归档成「一级目录/二级标签/标题」，配合 dsh-better-workspace 呈现工作区内部的嵌套会话分组；支持强制整理。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/rules.json",
    "cordis.patch.yml",
    "client.js",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Myer921/dsh-auto-session-groups.git"
  },
  "homepage": "https://github.com/Myer921/dsh-auto-session-groups",
  "bugs": {
    "url": "https://github.com/Myer921/dsh-auto-session-groups/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "grouping",
    "archive",
    "llm"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
